diff --git a/cmake/tiff-config.cmake.in b/cmake/tiff-config.cmake.in
index 19d54a72..710a1cd2 100644
--- a/cmake/tiff-config.cmake.in
+++ b/cmake/tiff-config.cmake.in
@@ -1,5 +1,23 @@
 if(NOT "@BUILD_SHARED_LIBS@")
-    # TODO: import dependencies
+  # Static build: the exported TIFF::tiff target lists its dependencies in the
+  # link interface (as $<LINK_ONLY:...>), but they are not defined for consumers.
+  # Define what is missing. The lookups are QUIET and optional: if a dependency
+  # cannot be found here, the behaviour is the same as without this block.
+  if("@ZLIB_SUPPORT@" AND NOT TARGET ZLIB::ZLIB)
+    find_package(ZLIB QUIET)
+  endif()
+  if("@ZSTD_SUPPORT@" AND NOT TARGET ZSTD::ZSTD)
+    # ZSTD::ZSTD is only an ALIAS inside the libtiff build (cmake/ZSTDCodec.cmake),
+    # it does not exist for consumers. Define it the same way for them.
+    find_package(zstd CONFIG QUIET)
+    if(TARGET zstd::libzstd_shared)
+      add_library(ZSTD::ZSTD INTERFACE IMPORTED)
+      set_target_properties(ZSTD::ZSTD PROPERTIES INTERFACE_LINK_LIBRARIES zstd::libzstd_shared)
+    elseif(TARGET zstd::libzstd_static)
+      add_library(ZSTD::ZSTD INTERFACE IMPORTED)
+      set_target_properties(ZSTD::ZSTD PROPERTIES INTERFACE_LINK_LIBRARIES zstd::libzstd_static)
+    endif()
+  endif()
 endif()
 
 function(set_variable_from_rel_or_absolute_path var root rel_or_abs_path)
