diff --git a/vcpkg_ports/libmariadb/libmariadb-config.cmake b/vcpkg_ports/libmariadb/libmariadb-config.cmake
index 74c628d..796229a 100644
--- a/vcpkg_ports/libmariadb/libmariadb-config.cmake
+++ b/vcpkg_ports/libmariadb/libmariadb-config.cmake
@@ -1,4 +1,36 @@
-include(CMakeFindDependencyMacro)
-find_dependency(unofficial-libmariadb CONFIG REQUIRED)
+#include(CMakeFindDependencyMacro)
+#find_dependency(unofficial-libmariadb CONFIG REQUIRED)
+#set(libmariadb_FOUND 1)
+#set(MYSQL_LIBRARIES unofficial::libmariadb)
+#
+# Custom replacement for the vcpkg-provided libmariadb config shim.
+# Defines unofficial::libmariadb directly from a manually installed
+# MariaDB Connector/C instead of forwarding to a vcpkg package.
+if(NOT TARGET unofficial::libmariadb)
+  add_library(unofficial::libmariadb UNKNOWN IMPORTED)
+  set_target_properties(unofficial::libmariadb PROPERTIES
+    IMPORTED_LOCATION "${ONELUAPRO_BUILDROOT}/lib/mariadb/mariadbclient.lib"
+    INTERFACE_INCLUDE_DIRECTORIES "${ONELUAPRO_BUILDROOT}/include/mariadb")
+
+  target_link_libraries(unofficial::libmariadb INTERFACE
+    "${ONELUAPRO_BUILDROOT}/lib/ssl.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/crypto.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/zlibstatic.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/zstd_static.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/libcurl.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/brotlicommon.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/brotlidec.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/nghttp2.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/nghttp3.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/ngtcp2.lib"
+    "${ONELUAPRO_BUILDROOT}/lib/ngtcp2_crypto_libressl.lib"
+    shlwapi
+    secur32
+    crypt32
+    wldap32
+    iphlpapi
+    normaliz)
+endif()
+
 set(libmariadb_FOUND 1)
 set(MYSQL_LIBRARIES unofficial::libmariadb)
