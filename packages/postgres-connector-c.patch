diff --git a/src/port/win32gettimeofday.c b/src/port/win32gettimeofday.c
index 1e00f7e..ac41d75 100644
--- a/src/port/win32gettimeofday.c
+++ b/src/port/win32gettimeofday.c
@@ -55,6 +55,16 @@ gettimeofday(struct timeval *tp, void *tzp)
 	FILETIME	file_time;
 	ULARGE_INTEGER ularge;
 
+	/*
+	 * GetSystemTimePreciseAsFileTime() does not exist before Windows 8.
+	 * Look it up at run time and fall back to the standard precision clock,
+	 * to stay compatible with Windows 7. Several threads may run the lookup
+	 * at the same time, they all get the same result.
+	 */
+	typedef VOID (WINAPI *get_time_precise_fn) (LPFILETIME);
+	static get_time_precise_fn pGetTimePrecise = NULL;
+	static int	initialized = 0;
+
 	/*
 	 * POSIX declines to define what tzp points to, saying "If tzp is not a
 	 * null pointer, the behavior is unspecified".  Let's take this
@@ -63,7 +73,21 @@ gettimeofday(struct timeval *tp, void *tzp)
 	 */
 	Assert(tzp == NULL);
 
-	GetSystemTimePreciseAsFileTime(&file_time);
+	if (!initialized)
+	{
+		HMODULE kernel32 = GetModuleHandleW(L"kernel32.dll");
+
+		if (kernel32)
+			pGetTimePrecise = (get_time_precise_fn)
+				GetProcAddress(kernel32, "GetSystemTimePreciseAsFileTime");
+		initialized = 1;
+	}
+
+	if (pGetTimePrecise)
+		pGetTimePrecise(&file_time);
+	else
+		GetSystemTimeAsFileTime(&file_time);
+
 	ularge.LowPart = file_time.dwLowDateTime;
 	ularge.HighPart = file_time.dwHighDateTime;
 
