# ------------------------------------------------------------------------------
# PROJ - slightly patched
ExternalProject_Add(proj
  PREFIX ${PROJECT_NAME}/proj
  GIT_REPOSITORY https://github.com/OSGeo/PROJ.git
  GIT_TAG "9.9.0"
  GIT_SHALLOW TRUE
  GIT_PROGRESS FALSE
  PATCH_COMMAND git apply -p1 "${CMAKE_CURRENT_SOURCE_DIR}/packages/proj.patch"
  CMAKE_ARGS
  "-DCMAKE_INSTALL_PREFIX=${ONELUAPRO_BUILDROOT}"
  "-DBUILD_SHARED_LIBS=OFF"
  "-DEMBED_RESOURCE_FILES=ON"
  "-DUSE_ONLY_EMBEDDED_RESOURCE_FILES=ON"
  "-DSQLite3_LIBRARY=${ONELUAPRO_BUILDROOT}/lib/sqlean.lib"
  "-DBUILD_TESTING=OFF"
  #
  "-G${CMAKE_GENERATOR}"
  "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}"
  "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}"
  "-DCMAKE_MSVC_RUNTIME_LIBRARY=${CMAKE_MSVC_RUNTIME_LIBRARY}"
  "-DCMAKE_C_FLAGS=${SUPERBUILD_LIGHT_C_FLAGS} ${SUPERBUILD_IPO_OPTS}"
  "-DCMAKE_CXX_FLAGS=${SUPERBUILD_LIGHT_CXX_FLAGS} ${SUPERBUILD_IPO_OPTS}"
  "-DCMAKE_EXE_LINKER_FLAGS=${SUPERBUILD_EXE_LINKER_FLAGS} ${SUPERBUILD_IPO_OPTS}"
  "-DCMAKE_STATIC_LINKER_FLAGS=${SUPERBUILD_STATIC_LINKER_FLAGS}"
  ${GENERATOR_ARGS}
)
add_dependencies(proj sqlean nlohmann_json libtiff curl)
