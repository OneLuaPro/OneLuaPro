diff --git a/src/include/odbc_scanner_extension.hpp b/src/include/odbc_scanner_extension.hpp
new file mode 100644
index 0000000..8ec611a
--- /dev/null
+++ b/src/include/odbc_scanner_extension.hpp
@@ -0,0 +1,17 @@
+#pragma once
+
+#include "duckdb.hpp"
+
+namespace duckdb {
+
+// Bridge class expected by DuckDB's generated static-extension loader
+// (naming convention: <name>_extension.hpp -> <Name>ScannerExtension).
+class OdbcScannerExtension : public Extension {
+public:
+	std::string Name() override {
+		return "odbc_scanner";
+	}
+	void Load(ExtensionLoader &loader) override;
+};
+
+} // namespace duckdb
diff --git a/src/odbc_scanner_bridge.cpp b/src/odbc_scanner_bridge.cpp
new file mode 100644
index 0000000..5338d40
--- /dev/null
+++ b/src/odbc_scanner_bridge.cpp
@@ -0,0 +1,34 @@
+// C++ side of the bridge. Only ever sees duckdb.hpp / extension_api.hpp,
+// never duckdb_extension.h - keeps the two duckdb_ext_api_v1 definitions apart.
+#include "duckdb.hpp"
+#include "duckdb/main/capi/extension_api.hpp"
+#include "odbc_scanner_extension.hpp"
+
+#include <stdexcept>
+#include <string>
+
+// Implemented in odbc_scanner_c_api_bridge.cpp, which only sees duckdb_extension.h.
+extern "C" bool odbc_scanner_run_init(const void *api_table_bytes, size_t api_table_size,
+                                       duckdb_connection connection, std::string *out_error);
+
+namespace duckdb {
+
+void OdbcScannerExtension::Load(ExtensionLoader &loader) {
+	// Local, not static: odbc-scanner's own capi_entry_point.cpp connects,
+	// initializes, and disconnects within a single function call, so the
+	// registration functions don't keep the connection around afterwards.
+	Connection conn(loader.GetDatabaseInstance());
+
+	// Build the real function-pointer table from DuckDB's own C++ side and
+	// hand it to the C-API side as raw bytes.
+	auto api_table = CreateAPIv1();
+	std::string error;
+	bool ok = odbc_scanner_run_init(&api_table, sizeof(api_table), reinterpret_cast<duckdb_connection>(&conn),
+	                                 &error);
+	if (!ok) {
+		throw std::runtime_error("odbc_scanner: " + error);
+	}
+	// conn is destroyed automatically here, mirroring the upstream duckdb_disconnect().
+}
+
+} // namespace duckdb
diff --git a/src/odbc_scanner_c_api_bridge.cpp b/src/odbc_scanner_c_api_bridge.cpp
new file mode 100644
index 0000000..b06f71e
--- /dev/null
+++ b/src/odbc_scanner_c_api_bridge.cpp
@@ -0,0 +1,56 @@
+// C-API side of the bridge. Only ever sees duckdb_extension.h, never duckdb.hpp.
+#include <cstring>
+#include <string>
+
+#include "duckdb_extension.h"
+#include "capi_entry_point.hpp"
+
+// The one real definition of this global lives in odbc-scanner's own,
+// unmodified capi_entry_point.cpp - we only reference it here.
+extern duckdb_ext_api_v1 duckdb_ext_api;
+
+namespace {
+
+  // duckdb_extension_info is an opaque pointer per duckdb.h - we're free to
+  // give it our own content instead of relying on DuckDB's internal format.
+  struct BridgeInfo {
+    std::string *error_out;
+  };
+
+  // Plain C function, never throws - it's called from inside the catch block
+  // of initiaize_odbc_scanner(), which is declared noexcept.
+  void bridge_set_error(duckdb_extension_info info, const char *error) {
+    auto *bi = reinterpret_cast<BridgeInfo *>(info);
+    if (bi && bi->error_out) {
+      *bi->error_out = error ? error : "unknown error";
+    }
+  }
+
+  // get_database/get_api are left null: verified (via grep across the whole
+  // odbc-scanner source) that nothing calls access->get_database or
+  // access->get_api in this init path - the extension pulls everything it
+  // needs through the already-populated duckdb_ext_api table instead.
+  duckdb_extension_access g_access = {bridge_set_error, nullptr, nullptr};
+
+} // namespace
+
+extern "C" bool odbc_scanner_run_init(const void *api_table_bytes, size_t api_table_size,
+                                       duckdb_connection connection, std::string *out_error) {
+  // duckdb_extension.h pins this extension to a fixed API version (v1.2.0);
+  // extension_api.hpp always hands us the engine's full, current struct.
+  // Per DuckDB's own ABI contract (api_spec/README: new fields are only
+  // ever appended, never inserted), the smaller, pinned struct is
+  // guaranteed to be a prefix of the larger one - so copying only as many
+  // bytes as our own struct expects is safe and correct, not a truncation bug.
+  if (api_table_size < sizeof(duckdb_ext_api_v1)) {
+    if (out_error) {
+      *out_error = "duckdb_ext_api_v1: engine API table smaller than expected "
+	"(engine older than the pinned extension API version?)";
+    }
+    return false;
+  }
+  std::memcpy(&duckdb_ext_api, api_table_bytes, sizeof(duckdb_ext_api_v1));
+  
+  BridgeInfo bi{out_error};
+  return initiaize_odbc_scanner(connection, reinterpret_cast<duckdb_extension_info>(&bi), &g_access);
+}
