# ------------------------------------------------------------------------------
# mariadb-connector-c - unaltered, original, fully static build
set(EXTRA_MARIADB_DEFS
  "/DCURL_STATICLIB")
ExternalProject_Add(mariadb-connector-c
  PREFIX ${PROJECT_NAME}/mariadb-connector-c
  GIT_REPOSITORY https://github.com/mariadb-corporation/mariadb-connector-c.git
  GIT_TAG "v3.4.10"
  GIT_SHALLOW TRUE
  GIT_PROGRESS FALSE
  CMAKE_ARGS
  "-DCMAKE_INSTALL_PREFIX=${ONELUAPRO_BUILDROOT}"
  "-DWITH_EXTERNAL_ZLIB=ON"
  "-DBUILD_SHARED_LIBS=OFF"
  "-DWITH_UNIT_TESTS=OFF"
  "-DPLUGIN_CACHING_SHA2_PASSWORD=STATIC"
  "-DPLUGIN_SHA256_PASSWORD=STATIC"
  "-DPLUGIN_CLIENT_ED25519=STATIC"
  "-DPLUGIN_DIALOG=STATIC"
  "-DPLUGIN_AUTH_GSSAPI_CLIENT=STATIC"
  "-DPLUGIN_PARSEC=STATIC"
  "-DPLUGIN_REMOTE_IO=STATIC"
  "-DPLUGIN_PVIO_SHMEM=STATIC"
  "-DPLUGIN_ZSTD=STATIC"
  "-DPLUGIN_MYSQL_CLEAR_PASSWORD=STATIC"
  "-DCURL_LIBRARIES=${ONELUAPRO_BUILDROOT}/lib/libcurl.lib"
  "-DWITH_SSL=OPENSSL"
  "-DDEFAULT_SSL_VERIFY_SERVER_CERT=ON"
  "-G${CMAKE_GENERATOR}"
  "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}"
  "-DCMAKE_MSVC_RUNTIME_LIBRARY=${CMAKE_MSVC_RUNTIME_LIBRARY}"
  "-DCMAKE_C_FLAGS=${EXTRA_MARIADB_DEFS} ${SUPERBUILD_C_FLAGS} ${SUPERBUILD_IPO_OPTS}"
  "-DCMAKE_EXE_LINKER_FLAGS=${SUPERBUILD_EXE_LINKER_FLAGS} ${SUPERBUILD_IPO_OPTS}"
  "-DCMAKE_STATIC_LINKER_FLAGS=${SUPERBUILD_STATIC_LINKER_FLAGS}"
  "-DCMAKE_SHARED_LINKER_FLAGS=${SUPERBUILD_SHARED_LINKER_FLAGS} ${LUA_IPO_OPTS}"
  ${GENERATOR_ARGS}
)
add_dependencies(mariadb-connector-c curl)
