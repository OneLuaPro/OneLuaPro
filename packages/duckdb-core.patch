diff --git a/scripts/apply_patch_if_needed.cmake b/scripts/apply_patch_if_needed.cmake
new file mode 100644
index 0000000000..8959916539
--- /dev/null
+++ b/scripts/apply_patch_if_needed.cmake
@@ -0,0 +1,25 @@
+# Applies PATCH_FILE to the current directory, unless it's already applied.
+# Uses the same --reverse --check trick as OneLuaPro's sqlean windirent.h
+# patch, just at patch-step time (when the checkout actually exists)
+# instead of at top-level configure time.
+# Usage: cmake -DGIT_EXECUTABLE=<path> -DPATCH_FILE=<path> -P apply_patch_if_needed.cmake
+
+execute_process(
+  COMMAND "${GIT_EXECUTABLE}" apply -p1 --reverse --check "${PATCH_FILE}"
+  RESULT_VARIABLE PATCH_ALREADY_APPLIED
+  OUTPUT_QUIET
+  ERROR_QUIET
+)
+
+if(PATCH_ALREADY_APPLIED EQUAL 0)
+  message(STATUS "Patch already applied, skipping: ${PATCH_FILE}")
+else()
+  message(STATUS "Applying patch: ${PATCH_FILE}")
+  execute_process(
+    COMMAND "${GIT_EXECUTABLE}" apply -p1 --whitespace=nowarn "${PATCH_FILE}"
+    RESULT_VARIABLE PATCH_RESULT
+  )
+  if(NOT PATCH_RESULT EQUAL 0)
+    message(FATAL_ERROR "Failed to apply patch: ${PATCH_FILE}")
+  endif()
+endif()
